#!/bin/bash
echo ""
read -p "   [0;32mPenguins Eggs Installer[0m

   This script will download and install Penguins Eggs, allowing the 
   creation of an installable snapshot of your existing system and
   The ability to redistribute it as a live image on usb or PXE.
     
   [0;31mhttps://github.com/pieroproietti/penguins-eggs[0m
   
   [0;34mAfter installation, adjust the build configuration with:[0m
   [0;33msudo eggs config[0m

   [0;34mThen build and move the resultant ISO to your home directory:[0m
   [0;33msudo eggs remaster && sudo mv -v /home/eggs/*.iso \"\$HOME/\"[0m
   
   [0;32m-----------------------------------------------------------------
   
   Please press enter to install Penguins Eggs.
   
   -----------------------------------------------------------------[0m
      
   Or close this terminal window to quit the install." ;
   if : >/dev/tcp/8.8.8.8/53; then
echo ""
cd /tmp || exit
rm -rf /tmp/fresh-eggs
sudo apt update &&
sudo apt install -y git &&
git clone https://github.com/pieroproietti/fresh-eggs.git &&
cd fresh-eggs &&
sudo ./fresh-eggs.sh || exit
echo ""
echo ""
echo "  [0;34m-------------------------------------------------------------[0m"
echo "  [0;32mAll Finished![0m"
echo ""
echo "  [0;34mTo get started, adjust the build configuration:[0m"
echo "  [0;33msudo eggs config[0m"
echo""
echo "  [0;34mThen build and move the resultant ISO to your home directory:[0m"
echo "  [0;33msudo eggs remaster && sudo mv -v /home/eggs/*.iso \"\$HOME/\"[0m"
echo ""
echo "  [0;32mGood luck, have fun![0m"
echo "  [0;34m-------------------------------------------------------------[0m"
else
echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
 echo ""
 echo "   [0;33mNo Internet connection. Please connect and try again.[0m"
 echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
echo ""
fi
echo ""
echo ""
read -n1 -p " Press any key to quit this dialog ... "
